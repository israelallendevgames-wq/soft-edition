{
  "name": "frame-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Estúdio de criação e planejamento de vídeos para YouTube.",
  "author": "israelallendevgames-wq",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^42.11.15",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.israelallendevgames.frame",
    "productName": "Frame Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "app.js",
      "index.html",
      "styles.css",
      "electron-main.cjs",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Frame-Studio-${version}-Windows-${arch}.${ext}"
    }
  }
}
